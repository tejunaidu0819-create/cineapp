# ─────────────────────────────────────────────────────────────────
# CineVerse Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────

# Neon PostgreSQL — get this from Vercel Marketplace → Neon integration
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require

# Secret for securing the cron endpoint that releases expired seat holds.
# Generate a strong random value, e.g.: openssl rand -hex 32
CRON_SECRET=replace_with_a_strong_random_secret

# Local Express server port (not used on Vercel)
PORT=3001
